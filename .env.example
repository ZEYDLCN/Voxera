VOXERA_ENVIRONMENT=local
VOXERA_DEBUG=true
VOXERA_LOG_LEVEL=INFO
VOXERA_SECRET_KEY=local-development-key-change-me
VOXERA_DATABASE_URL=postgresql+asyncpg://voxera_app:voxera-app-local@localhost:5432/voxera
VOXERA_DATABASE_ADMIN_URL=postgresql+asyncpg://voxera_admin:voxera-admin-local@localhost:5432/voxera
VOXERA_REDIS_URL=redis://localhost:6379/0
VOXERA_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
VOXERA_OBJECT_STORAGE_ACCESS_KEY=voxera
VOXERA_OBJECT_STORAGE_SECRET_KEY=voxera-local-secret
VOXERA_OBJECT_STORAGE_BUCKET=voxera-raw
